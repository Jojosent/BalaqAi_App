rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function shortString(value, max) { return value is string && value.size() <= max; }
    function validWeightEntry(value) {
      return value is map && value.keys().hasAll(['at', 'kg', 'week']) && value.keys().hasOnly(['at', 'kg', 'week']) &&
        value.at is int && value.at > 0 && value.at <= 253402300799999 && value.kg is number && value.kg >= 20 && value.kg <= 400 &&
        (value.week == null || (value.week is int && value.week >= 0 && value.week <= 42));
    }
    function validWeight(value) {
      return value is map && value.keys().hasAll(['baseline', 'reminder']) && value.keys().hasOnly(['baseline', 'reminder']) &&
        value.baseline is number && value.baseline >= 20 && value.baseline <= 400 && value.reminder is bool;
    }
    function validKick(value, allowActive) {
      return value is map && value.keys().hasAll(['startedAt', 'endedAt', 'count']) && value.keys().hasOnly(['startedAt', 'endedAt', 'count']) &&
        value.startedAt is int && value.startedAt > 0 && value.startedAt <= 253402300799999 &&
        value.count is int && value.count >= 0 && value.count <= 10000 &&
        ((allowActive && value.endedAt == null) ||
          (value.endedAt is int && value.endedAt >= value.startedAt && value.endedAt - value.startedAt <= 7200000));
    }
    function validTaskList(items) {
      let n = items.size();
      return items is list && n <= 10 &&
        (n <= 0 || (items[0] is string && items[0].size() > 0 && items[0].size() <= 160)) &&
        (n <= 1 || (items[1] is string && items[1].size() > 0 && items[1].size() <= 160)) &&
        (n <= 2 || (items[2] is string && items[2].size() > 0 && items[2].size() <= 160)) &&
        (n <= 3 || (items[3] is string && items[3].size() > 0 && items[3].size() <= 160)) &&
        (n <= 4 || (items[4] is string && items[4].size() > 0 && items[4].size() <= 160)) &&
        (n <= 5 || (items[5] is string && items[5].size() > 0 && items[5].size() <= 160)) &&
        (n <= 6 || (items[6] is string && items[6].size() > 0 && items[6].size() <= 160)) &&
        (n <= 7 || (items[7] is string && items[7].size() > 0 && items[7].size() <= 160)) &&
        (n <= 8 || (items[8] is string && items[8].size() > 0 && items[8].size() <= 160)) &&
        (n <= 9 || (items[9] is string && items[9].size() > 0 && items[9].size() <= 160));
    }
    function validTasks(value) {
      return value is map && value.keys().hasAll(['first', 'second', 'third', 'bag', 'home']) &&
        value.keys().hasOnly(['first', 'second', 'third', 'bag', 'home']) &&
        validTaskList(value.first) && validTaskList(value.second) && validTaskList(value.third) && validTaskList(value.bag) && validTaskList(value.home);
    }
    function validProfile(value) {
      return value is map && value.keys().hasAll(['name', 'birthday', 'city']) &&
        value.keys().hasOnly(['name', 'birthday', 'city']) &&
        shortString(value.name, 80) && shortString(value.city, 80) && shortString(value.birthday, 10) &&
        (value.birthday == '' || value.birthday.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{4}$'));
    }
    function validData(value) {
      return value is map &&
        value.keys().hasAll(['profile', 'stage', 'pregnancyStart', 'pregnancyNotes', 'checklist', 'trackingFolate']) &&
        value.keys().hasOnly(['profile', 'stage', 'pregnancyStart', 'pregnancyNotes', 'checklist', 'trackingFolate', 'customTasks']) &&
        (!('customTasks' in value) || validTasks(value.customTasks)) &&
        validProfile(value.profile) && value.stage in [null, 'pregnant', 'planning', 'postpartum'] &&
        (value.pregnancyStart == null || (shortString(value.pregnancyStart, 10) && value.pregnancyStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        value.pregnancyNotes is map && value.pregnancyNotes.keys().hasAll(['doctor', 'notes']) &&
        value.pregnancyNotes.keys().hasOnly(['doctor', 'notes']) &&
        shortString(value.pregnancyNotes.doctor, 100) && shortString(value.pregnancyNotes.notes, 1000) &&
        value.checklist is list && value.checklist.size() <= 100 && value.trackingFolate is bool;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow create, update: if owns(uid) &&
        request.resource.data.keys().hasAll(['data', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['data', 'updatedAt']) &&
        validData(request.resource.data.data) && shortString(request.resource.data.updatedAt, 40);
      allow list, delete: if false;
    }
    match /users/{uid}/customTasks/{groupId} {
      allow get, list: if owns(uid);
      allow create, update: if owns(uid) && groupId in ['first', 'second', 'third', 'bag', 'home'] &&
        request.resource.data.keys().hasAll(['tasks']) && request.resource.data.keys().hasOnly(['tasks']) && validTaskList(request.resource.data.tasks);
      allow delete: if false;
    }
    match /users/{uid}/kickSessions/{sessionId} {
      allow get, list: if owns(uid);
      allow create, update: if owns(uid) && validKick(request.resource.data, true) && sessionId == string(request.resource.data.startedAt);
      allow delete: if false;
    }
    match /users/{uid}/moodEntries/{entryId} {
      allow get, list: if owns(uid);
      allow create, update: if owns(uid) &&
        request.resource.data.keys().hasAll(['at', 'mood']) && request.resource.data.keys().hasOnly(['at', 'mood']) &&
        request.resource.data.at is int && request.resource.data.at > 0 && request.resource.data.at <= 253402300799999 &&
        entryId == string(request.resource.data.at) &&
        request.resource.data.mood in ['happiness', 'joy', 'excitement', 'satisfaction', 'love', 'gratitude', 'kindness', 'motivation', 'cheerful', 'appreciation', 'stress', 'fear', 'surprise', 'pain', 'anger', 'sadness', 'boredom', 'indifference'];
      allow delete: if false;
    }
    match /users/{uid}/weightEntries/{entryId} {
      allow get, list: if owns(uid);
      allow create, update: if owns(uid) && validWeightEntry(request.resource.data) && entryId == string(request.resource.data.at);
      allow delete: if false;
    }
    match /users/{uid}/tracking/weight {
      allow get: if owns(uid);
      allow create, update: if owns(uid) && validWeight(request.resource.data);
      allow list, delete: if false;
    }
    match /users/{uid}/settings/{setting} {
      allow read: if owns(uid);
      allow write: if owns(uid) && (
        (setting == 'preferences' && request.resource.data.keys().hasOnly(['language']) && request.resource.data.language in ['kk', 'ru', 'en']) ||
        (setting == 'sharing' && request.resource.data.keys().hasOnly(['inviteId']) && request.resource.data.inviteId.matches('^[a-f0-9]{48}$') && getAfter(/databases/$(database)/documents/shareInvites/$(request.resource.data.inviteId)).data.ownerUid == uid) ||
        (setting == 'shop' && request.resource.data.keys().hasOnly(['favourites']) && request.resource.data.favourites is list && request.resource.data.favourites.size() <= 30) ||
        (setting == 'community' && request.resource.data.keys().hasOnly(['liked', 'saved', 'followed']) && request.resource.data.liked is list && request.resource.data.liked.size() <= 100 && request.resource.data.saved is list && request.resource.data.saved.size() <= 100 && request.resource.data.followed is list && request.resource.data.followed.size() <= 100)
      );
    }
    match /users/{uid}/reminders/{id} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && request.resource.data.keys().hasOnly(['title', 'at', 'done']) && shortString(request.resource.data.title, 160) && request.resource.data.title.size() > 0 && request.resource.data.at is int && request.resource.data.at > 0 && request.resource.data.at <= 253402300799999 && request.resource.data.done is bool;
    }
    function activeInvite(id) {
      let invite = get(/databases/$(database)/documents/shareInvites/$(id)).data;
      return invite.enabled && invite.expiresAt > request.time;
    }
    function inviteOwner(id) { return owns(get(/databases/$(database)/documents/shareInvites/$(id)).data.ownerUid); }
    match /shareInvites/{id} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && id.matches('^[a-f0-9]{48}$') && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt', 'expiresAt', 'enabled']) && owns(request.resource.data.ownerUid) && request.resource.data.enabled == true && request.resource.data.createdAt == request.time && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if owns(resource.data.ownerUid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled']) && request.resource.data.enabled == false;
      allow delete: if false;
    }
    match /shareInvites/{id}/members/{viewer} {
      allow get: if owns(viewer) || inviteOwner(id);
      allow list: if inviteOwner(id);
      allow create: if owns(viewer) && activeInvite(id) && !inviteOwner(id) && request.resource.data.keys().hasOnly(['active']) && request.resource.data.active == true;
      allow update: if inviteOwner(id) && request.resource.data.keys().hasOnly(['active']) && request.resource.data.active == false;
      allow delete: if false;
    }
    match /shareData/{id} {
      allow get: if inviteOwner(id) || (request.auth != null && activeInvite(id) && get(/databases/$(database)/documents/shareInvites/$(id)/members/$(request.auth.uid)).data.active == true);
      allow list, delete: if false;
      allow create, update: if request.auth != null && owns(getAfter(/databases/$(database)/documents/shareInvites/$(id)).data.ownerUid) &&
        request.resource.data.keys().hasOnly(['ownerUid', 'name', 'pregnancyStart', 'completed', 'scope']) && owns(request.resource.data.ownerUid) && shortString(request.resource.data.name, 80) &&
        (request.resource.data.pregnancyStart == null || (shortString(request.resource.data.pregnancyStart, 10) && request.resource.data.pregnancyStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        request.resource.data.completed is int && request.resource.data.completed >= 0 && request.resource.data.completed <= 100 &&
        request.resource.data.scope.keys().hasOnly(['name', 'pregnancy', 'progress']) && request.resource.data.scope.name is bool && request.resource.data.scope.pregnancy is bool && request.resource.data.scope.progress is bool &&
        (request.resource.data.scope.name || request.resource.data.name == '') && (request.resource.data.scope.pregnancy || request.resource.data.pregnancyStart == null) && (request.resource.data.scope.progress || request.resource.data.completed == 0);
    }
    match /users/{uid}/connections/{id} {
      allow read, delete: if owns(uid);
      allow create: if owns(uid) && request.resource.data.keys().hasOnly(['ownerUid']) && request.resource.data.ownerUid == get(/databases/$(database)/documents/shareInvites/$(id)).data.ownerUid && getAfter(/databases/$(database)/documents/shareInvites/$(id)/members/$(uid)).data.active == true;
      allow update: if false;
    }
    match /communityPosts/{post}/comments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['uid', 'postId', 'author', 'text', 'at']) && owns(request.resource.data.uid) && post in ['kamala', 'sneha'] && request.resource.data.postId == post && shortString(request.resource.data.author, 80) && shortString(request.resource.data.text, 500) && request.resource.data.text.size() > 0 && request.resource.data.at == request.time;
      allow delete: if owns(resource.data.uid);
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
