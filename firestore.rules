rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid &&
        (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']);
    }
    function shortString(value, max) { return value is string && value.size() <= max; }
    function validProfile(value) {
      return value is map && value.keys().hasAll(['name', 'birthday', 'city']) &&
        value.keys().hasOnly(['name', 'birthday', 'city']) &&
        shortString(value.name, 80) && shortString(value.city, 80) && shortString(value.birthday, 10) &&
        (value.birthday == '' || value.birthday.matches('^[0-9]{2}[.][0-9]{2}[.][0-9]{4}$'));
    }
    function validData(value) {
      return value is map &&
        value.keys().hasAll(['profile', 'stage', 'pregnancyStart', 'pregnancyNotes', 'checklist', 'trackingFolate']) &&
        value.keys().hasOnly(['profile', 'stage', 'pregnancyStart', 'pregnancyNotes', 'checklist', 'trackingFolate']) &&
        validProfile(value.profile) && value.stage in [null, 'pregnant', 'planning', 'postpartum'] &&
        (value.pregnancyStart == null || (shortString(value.pregnancyStart, 10) && value.pregnancyStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        value.pregnancyNotes is map && value.pregnancyNotes.keys().hasAll(['doctor', 'notes']) &&
        value.pregnancyNotes.keys().hasOnly(['doctor', 'notes']) &&
        shortString(value.pregnancyNotes.doctor, 100) && shortString(value.pregnancyNotes.notes, 1000) &&
        value.checklist is list && value.checklist.size() <= 100 && value.trackingFolate is bool;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow create, update: if owns(uid) &&
        request.resource.data.keys().hasAll(['data', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['data', 'updatedAt']) &&
        validData(request.resource.data.data) && shortString(request.resource.data.updatedAt, 40);
      allow list, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
